{
  "name": "security-testing-multiagent-kali",
  "version": "3.0.0",
  "description": "Multi-agent penetration testing orchestration framework driving Kali Linux tools via Claude Code",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:dev": "NODE_ENV=development node server.js",
    "assess": "node bin/start-assessment.js",
    "assess:headless": "node bin/start-assessment.js --headless",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:phase1": "jest tests/phase1-integration.test.js",
    "test:phase2": "jest tests/phase2-integration.test.js",
    "test:phase3": "jest tests/phase3-integration.test.js",
    "test:kali": "jest tests/kali-tools-integration.test.js",
    "test:kali:expanded": "jest tests/kali-tools-expanded.test.js",
    "test:kali:maximum": "jest tests/kali-tools-maximum.test.js",
    "test:kali:ultra": "jest tests/kali-tools-ultra-maximum.test.js",
    "test:orchestration": "jest tests/orchestration.test.js",
    "test:all": "jest --coverage",
    "test:tools": "jest tests/kali-tools*.test.js",
    "test:chains": "jest tests/orchestration.test.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "js-yaml": "4.1.0",
    "ajv": "8.17.1",
    "jsonwebtoken": "^9.1.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=14"
  },
  "license": "Apache-2.0"
}
