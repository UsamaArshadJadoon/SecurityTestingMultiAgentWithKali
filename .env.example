# ============================================
# SECURITY TESTING MULTI-AGENT FRAMEWORK
# Environment Variables Configuration
# ============================================

# CRITICAL: Authentication & Security (REQUIRED)
# ============================================

# JWT token secret for authentication
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-32-byte-base64-encoded-secret-key

# Request signing secret (HMAC-SHA256)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REQUEST_SIGNING_SECRET=your-32-byte-base64-encoded-secret-key

# Keystore master key for encrypting keys at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEYSTORE_MASTER_KEY=your-32-byte-base64-encoded-secret-key

# ============================================
# Optional Configuration
# ============================================

# Node environment (development, staging, production)
# IMPORTANT: Always set to 'production' for production deployments
NODE_ENV=production

# Server port
PORT=3000

# Authentication enforcement
# Set to 'false' ONLY for testing/development with explicit control
REQUIRE_AUTH=true

# ============================================
# Database Configuration
# ============================================

DB_MIN_CONN=5
DB_MAX_CONN=20
DB_IDLE_TIMEOUT=30000

# ============================================
# Rate Limiting
# ============================================

RATE_LIMIT_USER=100
RATE_LIMIT_TENANT=1000

# ============================================
# Timeouts
# ============================================

TIMEOUT_REQUEST=30000
TIMEOUT_SHUTDOWN=30000

# ============================================
# CORS Configuration
# ============================================

CORS_ENABLED=false
CORS_ORIGINS=http://localhost:3000

# ============================================
# Logging
# ============================================

LOG_LEVEL=info
LOG_DIR=logs
AUDIT_LOG_DIR=audit-logs

# ============================================
# Features
# ============================================

FEATURE_FLAGS_ENABLED=true
